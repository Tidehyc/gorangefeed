# Application
APP_ENV=development
APP_LOG_LEVEL=info
APP_LOG_FORMAT=text

# HTTP Server
SERVER_PORT=8080

# MySQL (Docker Compose Host Port: 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root_password
DB_NAME=gorangefeed
MYSQL_PARAMS=charset=utf8mb4&parseTime=True&loc=Local

# Redis (Docker Compose Host Port: 6380)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ (Docker Compose Host Port: 5673)
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5673
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=gorangefeed_access_default_secret_key
JWT_REFRESH_SECRET=gorangefeed_refresh_default_secret_key
